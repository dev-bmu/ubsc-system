# UBSC multi-node production overlay.
# Merge these non-secret switches with secrets supplied by the hosting secret
# manager. Never commit real credentials, access keys, or application keys.
# Do not use this overlay merely because a second VPS was purchased. Complete
# docs/operations/07-PERUBAHAN-MODE-INFRASTRUKTUR.md and prove every HA gate.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://ubsportcenter.co.id
SEO_CANONICAL_ORIGIN=https://ubsportcenter.co.id
GALLERY_CANONICAL_ORIGIN=https://ubsportcenter.co.id
APP_RELEASE=replace-with-immutable-release-id
ACTIVATE_RELEASE_COMMAND_TIMEOUT_SECONDS=600

# Deployment contract: activation fails closed when any required shared-state
# invariant is missing.
PRODUCTION_CONTRACT_ENFORCE=true
HIGH_AVAILABILITY_CONTRACT_ENFORCE=true
DATABASE_REPLICATION_CONTRACT_ENFORCE=true
DEPLOYMENT_CONTRACT_ENFORCE=true
PROCESS_SUPERVISION_ENFORCE=true
DISASTER_RECOVERY_CONTRACT_ENFORCE=true
OBSERVABILITY_CONTRACT_ENFORCE=true
PROCESS_SUPERVISOR_CONFIG_PATH=/etc/supervisor/conf.d/ubsc.conf
PROCESS_SUPERVISION_MAX_CLOCK_SKEW_SECONDS=30
PRODUCTION_TOPOLOGY=multi_node
PRODUCTION_APP_INSTANCES=2
# Must be unique on every application node, for example ubsc-app-01 and
# ubsc-app-02. It is exposed publicly only as a truncated SHA-256 identity.
PRODUCTION_INSTANCE_ID=replace-with-unique-node-id
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=coordination

# Keep a bounded local fallback and stream sanitized structured JSON to the
# hosting log collector. The collector must persist it outside all app nodes.
LOG_CHANNEL=stack
LOG_STACK=daily,json_stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Managed load balancer. Configure the real private IPs/CIDRs supplied by the
# hosting platform; never trust all proxies.
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_MANAGED_SERVICE=true
LOAD_BALANCER_HA_ENABLED=true
LOAD_BALANCER_AUTOMATIC_FAILOVER=true
LOAD_BALANCER_FAILOVER_RTO_SECONDS=60
LOAD_BALANCER_MIN_FAILURE_DOMAINS=2
LOAD_BALANCER_HEALTH_PATH=/health/ready
LOAD_BALANCER_EXPOSE_INSTANCE_HEADER=true
LOAD_BALANCER_EXPOSE_RELEASE_HEADER=true
LOAD_BALANCER_FORWARDED_FOR_MODE=replace
LOAD_BALANCER_READINESS_EDGE_PROTECTED=true
LOAD_BALANCER_STICKY_SESSIONS=false
LOAD_BALANCER_HEALTH_INTERVAL_SECONDS=5
LOAD_BALANCER_HEALTH_TIMEOUT_SECONDS=5
LOAD_BALANCER_CONNECTION_DRAIN_SECONDS=30
TRUSTED_PROXIES=10.0.0.0/24

# Immutable rolling release and managed public edge. The provider names must
# identify real provisioned services; release checks reject placeholders.
DEPLOYMENT_STRATEGY=rolling
DEPLOYMENT_ORCHESTRATOR_PROVIDER=replace-with-deployment-provider
DEPLOYMENT_IMMUTABLE_RELEASES=true
DEPLOYMENT_ATOMIC_TRAFFIC_SWITCH=true
DEPLOYMENT_HEALTH_GATED=true
DEPLOYMENT_CONNECTION_DRAINING=true
DEPLOYMENT_AUTOMATIC_APP_ROLLBACK=true
DEPLOYMENT_MAX_UNAVAILABLE=1
DEPLOYMENT_MIN_HEALTHY_INSTANCES=1
DEPLOYMENT_RETAINED_RELEASES=5
DEPLOYMENT_EXPAND_CONTRACT_REQUIRED=true
DEPLOYMENT_SCHEMA_BACKWARD_COMPATIBLE_RELEASES=2
DEPLOYMENT_AUTOMATIC_DB_ROLLBACK=false
DEPLOYMENT_APP_ROOT=/srv/ubsc
DEPLOYMENT_RELEASES_ROOT=/srv/ubsc/releases
DEPLOYMENT_CURRENT_LINK=/srv/ubsc/current
DEPLOYMENT_LOCAL_READINESS_URL=http://127.0.0.1:8080/health/ready
DEPLOYMENT_LOCK_TIMEOUT_SECONDS=1800
DEPLOYMENT_CONNECTION_DRAIN_SECONDS=30
DEPLOYMENT_COMMAND_TIMEOUT_SECONDS=900
# Shell-only provider adapters used by atomic-node-rollout.sh. Keep credentials
# inside workload identity/secret manager, never in these command paths.
DEPLOYMENT_DRAIN_HOOK=/usr/local/libexec/ubsc-drain-node
DEPLOYMENT_UNDRAIN_HOOK=/usr/local/libexec/ubsc-undrain-node
DEPLOYMENT_MINIMUM_DISK_FREE_PERCENT=15
EDGE_CERTIFICATE_MIN_VALIDITY_SECONDS=1209600
EDGE_PROVIDER=replace-with-managed-edge-provider
EDGE_MANAGED_DNS=true
EDGE_CDN_ENABLED=true
EDGE_WAF_ENABLED=true
EDGE_DDOS_PROTECTION=true
EDGE_TLS_TERMINATION=true
EDGE_ORIGIN_TLS=true
EDGE_ORIGIN_ACCESS_RESTRICTED=true
EDGE_CERTIFICATE_AUTO_RENEWAL=true
EDGE_MINIMUM_TLS_VERSION=1.2
EDGE_HEALTH_PATH=/health/ready

# Mandatory layered DDoS posture. These declarations are checked at runtime;
# the provider hook must independently verify the live edge configuration.
DDOS_PROTECTION_CONTRACT_ENFORCE=true
APPLICATION_TRAFFIC_PROTECTION_ENABLED=true
REQUEST_RESOURCE_ENVELOPE_ENABLED=true
REQUEST_MAX_TARGET_BYTES=4096
REQUEST_MAX_QUERY_BYTES=2048
REQUEST_MAX_QUERY_PARAMETERS=100
REQUEST_MAX_QUERY_DEPTH=8
REQUEST_MAX_HEADER_COUNT=96
REQUEST_MAX_HEADER_BYTES=32768
REQUEST_MAX_COOKIE_BYTES=8192
REQUEST_DEFAULT_BODY_BYTES=2097152
TRAFFIC_WEB_IP_RPS=40
TRAFFIC_WEB_IP_RPM=1200
TRAFFIC_WEB_NETWORK_RPM=12000
TRAFFIC_WEB_GLOBAL_RPS=600
TRAFFIC_WEB_GLOBAL_RPM=24000
TRAFFIC_REGISTER_IP_15M=5
TRAFFIC_REGISTER_NETWORK_HOUR=100
TRAFFIC_REGISTER_GLOBAL_RPM=300
TRAFFIC_REVIEW_ACTOR_HOUR=10
TRAFFIC_REVIEW_IP_HOUR=60
TRAFFIC_OAUTH_IP_RPM=60
TRAFFIC_OAUTH_NETWORK_RPM=600
TRAFFIC_SITEMAP_IP_RPM=30
TRAFFIC_SITEMAP_GLOBAL_RPM=1000
TRAFFIC_ANALYTICS_IP_RPM=180
TRAFFIC_ANALYTICS_NETWORK_RPM=3000
DDOS_EDGE_ALWAYS_ON=true
DDOS_EDGE_GLOBAL_SCRUBBING=true
DDOS_EDGE_L3_L4_AUTOMATIC=true
DDOS_EDGE_L7_AUTOMATIC=true
DDOS_EDGE_MANAGED_WAF_RULES=true
DDOS_EDGE_ADAPTIVE_RATE_LIMITING=true
DDOS_EDGE_BOT_MANAGEMENT=true
DDOS_EDGE_STATIC_ASSET_CACHE=true
DDOS_EDGE_PRIVATE_HTML_BYPASS=true
DDOS_ORIGIN_DIRECT_ACCESS_DISABLED=true
DDOS_ORIGIN_IP_DISCLOSURE_PREVENTED=true
DDOS_ORIGIN_AUTHENTICATION_MODE=private_network
# The edge must delete every caller-supplied copy and set exactly one verified
# IP header; the load balancer then replaces X-Forwarded-For from that value.
DDOS_VERIFIED_CLIENT_IP_HEADER=x-verified-client-ip
DDOS_EDGE_STRIPS_SPOOFED_IP_HEADERS=true
DDOS_LB_REPLACES_FORWARDED_FOR=true
DDOS_SECURITY_EVENT_STREAM_ENABLED=true
DDOS_ATTACK_ALERTING_ENABLED=true
DDOS_ORIGIN_SATURATION_ALERTING_ENABLED=true
DDOS_COST_ANOMALY_ALERTING_ENABLED=true
DDOS_EMERGENCY_MODE_AVAILABLE=true
DDOS_PROVIDER_ESCALATION_CONFIGURED=true
DDOS_RESPONSE_RUNBOOK=docs/DDOS_RESPONSE_OPERATIONS.md
DDOS_PROVIDER_RESPONSE_SLA_SECONDS=900
DDOS_EXERCISE_INTERVAL_DAYS=90
DDOS_PROVIDER_VERIFICATION_MODE=provider_api
DDOS_PROVIDER_VERIFY_HOOK=/usr/local/libexec/ubsc-verify-ddos-provider
DDOS_PROVIDER_ZONE_FINGERPRINT=replace-with-sha256-of-exact-provider-zone-id
DDOS_EDGE_RESPONSE_HEADER=x-edge-request-id
DDOS_PROVIDER_VERIFY_TIMEOUT_SECONDS=30

# Managed database writer. Credentials belong in the secret manager.
DB_CONNECTION=mariadb
DB_HOST=managed-database-writer.internal
DB_PORT=3306
DB_DATABASE=ubsc
DB_USERNAME=secret-manager-reference
DB_PASSWORD=secret-manager-reference
DB_CONNECT_TIMEOUT_SECONDS=3
DB_TRANSACTION_ATTEMPTS=3
DB_MANAGED_SERVICE=true
DB_HA_ENABLED=true
DB_AUTOMATIC_FAILOVER=true
DB_FAILOVER_ENDPOINT_KIND=cluster
DB_HA_MIN_AZS=2
DB_FAILOVER_RTO_SECONDS=120
DB_TLS_REQUIRED=true
DB_TLS_VERIFY_PEER=true
# Mount the provider CA bundle outside the release and keep its path stable.
MYSQL_ATTR_SSL_CA=/run/secrets/managed-database-ca.pem

# Managed single-writer replication. The external observer owns provider read
# privileges and signing credentials; application hosts receive public keys.
DB_REPLICATION_ENABLED=true
DB_REPLICATION_MANAGED_SERVICE=true
DB_REPLICATION_PROVIDER=replace-with-managed-database-provider-id
DB_REPLICATION_CLUSTER_ID=replace-with-managed-cluster-id
DB_REPLICATION_DATASET_ID=replace-with-opaque-relational-dataset-id
DB_REPLICATION_ENVIRONMENT=production
DB_REPLICATION_PRIMARY_REGION=replace-with-primary-region
DB_REPLICATION_WRITER_ENDPOINT_ID=replace-with-stable-writer-endpoint-id
DB_REPLICATION_READER_ENDPOINT_ID=replace-with-stable-reader-endpoint-id
DB_REPLICATION_INDEPENDENT_OBSERVER=replace-with-independent-observer-id
DB_REPLICATION_MODE=synchronous
DB_REPLICATION_SINGLE_WRITER=true
DB_REPLICATION_AUTOMATIC_FAILOVER=true
DB_REPLICATION_AUTOMATIC_FAILBACK=false
DB_REPLICATION_MIN_AZS=2
DB_REPLICATION_MIN_REPLICAS=2
DB_REPLICATION_MIN_SYNC_REPLICAS=1
DB_REPLICATION_QUORUM_REQUIRED=true
DB_REPLICATION_FENCING_REQUIRED=true
DB_REPLICATION_PROMOTION_CATCHUP_REQUIRED=true
DB_REPLICATION_MAX_DATA_LOSS_BYTES=0
DB_REPLICATION_FAILOVER_RTO_SECONDS=120
DB_REPLICATION_GTID_REQUIRED=true
DB_REPLICATION_ROW_BINLOG_REQUIRED=true
DB_REPLICATION_REPLICA_READ_ONLY_REQUIRED=true
DB_REPLICATION_LAG_WARNING_MS=2000
DB_REPLICATION_LAG_OUTAGE_MS=10000
DB_REPLICATION_OBSERVATION_ENABLED=true
DB_REPLICATION_OBSERVATION_WARNING_SECONDS=120
DB_REPLICATION_OBSERVATION_OUTAGE_SECONDS=300
DB_REPLICATION_ATTESTATION_REQUIRED=true
# Public keys only; the observer private key never reaches an application host.
DB_REPLICATION_ATTESTATION_VERIFYING_KEYS={}
DB_REPLICATION_ATTESTATION_ACTIVE_KEY_IDS=observer-v1
DB_REPLICATION_ATTESTATION_MAX_BYTES=65536
DB_REPLICATION_ATTESTATION_MAX_ENVELOPE_BYTES=98304
DB_REPLICATION_ATTESTATION_CLOCK_SKEW_SECONDS=120
DB_REPLICATION_ATTESTATION_MAX_AGE_SECONDS=900
DB_REPLICATION_LEDGER_ACTIVE_KEY_ID=v1
# Independent 32+ byte HMAC key ring supplied by the deployment secret manager.
DB_REPLICATION_LEDGER_SIGNING_KEYS={}
DB_REPLICATION_LEDGER_WARNING_SECONDS=7200
DB_REPLICATION_LEDGER_OUTAGE_SECONDS=14400
DB_REPLICATION_EVENT_LIMIT=30
REPLICATION_COMMAND_TIMEOUT_SECONDS=30
REPLICATION_IMPORT_TIMEOUT_SECONDS=30
# Required only for the first release that creates replication control-plane
# tables. Supply a fresh signed envelope, then remove the file after activation.
DB_REPLICATION_BOOTSTRAP_ATTESTATION_FILE=/run/ubsc/replication/bootstrap-topology.signed.json

# Keep disabled initially. Only explicitly eventual read models may opt in;
# every consistency-sensitive path continues to use the writer.
DB_REPLICA_READS_ENABLED=false
DB_REPLICA_CONNECTION=mariadb_replica
DB_REPLICA_FALLBACK_TO_WRITER=true
DB_REPLICA_READ_AFTER_WRITE_SECONDS=30
DB_REPLICA_HOST=managed-database-reader.internal
DB_REPLICA_PORT=3306
DB_REPLICA_DATABASE=ubsc
DB_REPLICA_USERNAME=secret-manager-select-only-reference
DB_REPLICA_PASSWORD=secret-manager-reference

# Continuous provider recovery plus an independent immutable database-only
# copy. These flags are declarations checked by release activation; they do
# not enable provider features. Supply the HMAC key ring through the secret
# manager and retain old keys during rotation.
RECOVERY_POINT_OBJECTIVE_SECONDS=300
RECOVERY_TIME_OBJECTIVE_SECONDS=3600
RECOVERY_PROVIDER=replace-with-managed-database-provider-id
RECOVERY_DATASET_ID=replace-with-opaque-relational-dataset-id
RECOVERY_PRIMARY_REGION=replace-with-primary-region
RECOVERY_SECONDARY_REGION=replace-with-distinct-recovery-region
RECOVERY_BACKUP_DESTINATION_ID=replace-with-independent-vault-id
RECOVERY_INDEPENDENT_VERIFIER=replace-with-protected-verifier-id
DB_PITR_ENABLED=true
DB_PITR_PROVIDER_MANAGED=true
DB_PITR_CONTINUOUS=true
DB_PITR_RETENTION_DAYS=14
DB_PITR_OBSERVATION_ENABLED=true
DB_PITR_OBSERVATION_WARNING_SECONDS=600
DB_PITR_OBSERVATION_OUTAGE_SECONDS=1200
DB_IMMUTABLE_BACKUP_ENABLED=true
DB_BACKUP_SCOPE=database
DB_BACKUP_ENCRYPTED=true
DB_BACKUP_OFFSITE=true
DB_BACKUP_CROSS_ACCOUNT=true
DB_BACKUP_CROSS_REGION=true
DB_BACKUP_IMMUTABLE=true
DB_BACKUP_OBJECT_LOCK_MODE=compliance
DB_BACKUP_RETENTION_DAYS=35
DB_BACKUP_EXPECTED_INTERVAL_SECONDS=86400
RESTORE_DRILL_ENABLED=true
RESTORE_DRILL_INTERVAL_DAYS=90
RESTORE_DRILL_GRACE_DAYS=14
RESTORE_DRILL_ISOLATED_TARGET_REQUIRED=true
RESTORE_DRILL_PRODUCTION_TARGET_FORBIDDEN=true
RECOVERY_EVIDENCE_ACTIVE_KEY_ID=v1
# Required secret-manager value, e.g. {"v1":"base64:<random-32+-byte-key>"}.
RECOVERY_EVIDENCE_SIGNING_KEYS={}
RECOVERY_EVIDENCE_WARNING_SECONDS=7200
RECOVERY_EVIDENCE_OUTAGE_SECONDS=14400
# Public keys only. The protected verifier's private key must never be mounted
# on a web, queue, scheduler, database, or general application host.
RECOVERY_ATTESTATION_REQUIRED=true
RECOVERY_ATTESTATION_VERIFYING_KEYS={}
RECOVERY_ATTESTATION_ACTIVE_KEY_IDS=verifier-v1
RECOVERY_ATTESTATION_MAX_BYTES=65536
RECOVERY_ATTESTATION_MAX_ENVELOPE_BYTES=98304
RECOVERY_ATTESTATION_CLOCK_SKEW_SECONDS=300
RECOVERY_COMMAND_TIMEOUT_SECONDS=30

# Controlled game days run only against the isolated staging twin. A protected
# external orchestrator injects one fault at a time and signs its evidence;
# this application never receives provider mutation credentials.
RESILIENCE_DRILLS_ENABLED=true
RESILIENCE_DRILLS_ENFORCE=true
RESILIENCE_TARGET_ENVIRONMENT=staging
RESILIENCE_TARGET_INFRASTRUCTURE_PROFILE=replace-with-staging-ha-twin-profile
RESILIENCE_PROVIDER=replace-with-infrastructure-provider-id
RESILIENCE_ORCHESTRATOR=replace-with-independent-orchestrator-id
RESILIENCE_REQUIRED_SCENARIOS=application_node_loss,load_balancer_failover,queue_worker_restart,cache_primary_failover,database_writer_failover
RESILIENCE_CAMPAIGN_INTERVAL_DAYS=90
RESILIENCE_CAMPAIGN_GRACE_DAYS=14
RESILIENCE_MAX_CAMPAIGN_SECONDS=14400
RESILIENCE_PRODUCTION_INJECTION_FORBIDDEN=true
RESILIENCE_EXTERNAL_ORCHESTRATOR_REQUIRED=true
RESILIENCE_MANUAL_APPROVAL_REQUIRED=true
RESILIENCE_CHANGE_REFERENCE_REQUIRED=true
RESILIENCE_SYNTHETIC_TRAFFIC_ONLY=true
RESILIENCE_KILL_SWITCH_REQUIRED=true
RESILIENCE_ONE_FAULT_AT_A_TIME=true
RESILIENCE_MAX_BLAST_RADIUS_PERCENT=50
RESILIENCE_MINIMUM_HEALTHY_INSTANCES=1
RESILIENCE_MAX_SCENARIO_SECONDS=900
RESILIENCE_ABORT_ERROR_RATE_PERCENT=2
RESILIENCE_ABORT_P95_MS=3000
# Required secret-manager value containing public keys only, for example
# {"orchestrator-v1":"base64:<base64-encoded-PEM-public-key>"}.
RESILIENCE_EVIDENCE_VERIFYING_KEYS={}
RESILIENCE_EVIDENCE_ACTIVE_KEY_IDS=orchestrator-v1
RESILIENCE_EVIDENCE_MAX_BYTES=131072
RESILIENCE_EVIDENCE_MAX_ENVELOPE_BYTES=196608
RESILIENCE_EVIDENCE_CLOCK_SKEW_SECONDS=300
RESILIENCE_LEDGER_ACTIVE_KEY_ID=v1
# Independent 32+ byte HMAC key ring; never reuse APP_KEY or provider secrets.
RESILIENCE_LEDGER_SIGNING_KEYS={}
RESILIENCE_LEDGER_WARNING_SECONDS=129600
RESILIENCE_LEDGER_OUTAGE_SECONDS=259200

# Shared state. Independent managed failover endpoints prevent cache pressure
# or eviction from terminating sessions, losing queued work, or invalidating
# cross-node coordination locks.
SESSION_DRIVER=redis
SESSION_CONNECTION=session
CACHE_STORE=redis
CACHE_LIMITER_STORE=traffic
REDIS_TRAFFIC_CONNECTION=traffic
REDIS_CACHE_LOCK_CONNECTION=coordination
REDIS_COORDINATION_CONNECTION=coordination
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
BACKGROUND_JOB_CONNECTION=redis
BACKGROUND_MEDIA_CONNECTION=redis-long
MONITORING_QUEUE_CONNECTION=redis
PERFORMANCE_METRICS_ENABLED=true
PERFORMANCE_METRICS_DRIVER=redis
PERFORMANCE_METRICS_REDIS_CONNECTION=cache
DATA_INTEGRITY_CACHE_STORE=redis
INVOICE_PDF_LOCK_STORE=redis

# Capacity control plane. The application signs bounded desired state; only a
# separately credentialed provider adapter may mutate infrastructure.
CAPACITY_PLANNING_ENABLED=true
CAPACITY_PLANNING_ENFORCE=true
CAPACITY_AUTOSCALING_MODE=signed_plan
CAPACITY_TARGET_ENVIRONMENT=production
CAPACITY_INFRASTRUCTURE_PROFILE=replace-with-immutable-capacity-profile
CAPACITY_PLATFORM_PROVIDER=replace-with-provider-adapter-id
CAPACITY_MANAGED_TARGETS=web,queue:critical,queue:documents,queue:notifications,queue:media_image,queue:media_video,queue:media_maintenance,queue:maintenance,queue:default
CAPACITY_DECISION_LOCK_SECONDS=30
CAPACITY_DECISION_LOCK_WAIT_SECONDS=5
CAPACITY_OBSERVATION_MAX_AGE_SECONDS=120
CAPACITY_MINIMUM_LIVE_OBSERVATIONS=2
CAPACITY_MINIMUM_OBSERVATION_SPACING_SECONDS=15
CAPACITY_MAXIMUM_OBSERVATION_SPACING_SECONDS=75
CAPACITY_MAX_CLOCK_SKEW_SECONDS=30
CAPACITY_MAX_PAYLOAD_BYTES=65536
CAPACITY_OBSERVATION_ACTIVE_KEY_ID=v1
# Independent secret-manager values; never reuse APP_KEY or database secrets.
CAPACITY_OBSERVATION_SIGNING_KEYS={}
CAPACITY_REQUIRED_EVIDENCE_SCOPES=public_read,booking_checkout,admin,authentication,write
CAPACITY_EVIDENCE_MAX_AGE_DAYS=30
CAPACITY_EVIDENCE_EXPECTED_INSTANCES=2
CAPACITY_EVIDENCE_MIN_HOLD_SECONDS=300
CAPACITY_OPERATIONAL_HEADROOM_PERCENT=25
CAPACITY_EVIDENCE_MAX_ERROR_PERCENT=1
CAPACITY_EVIDENCE_REQUIRE_RELEASE_MATCH=true
CAPACITY_EVIDENCE_ACTIVE_KEY_ID=v1
CAPACITY_EVIDENCE_SIGNING_KEYS={}
CAPACITY_PLAN_TTL_SECONDS=90
CAPACITY_SCALE_UP_COOLDOWN_SECONDS=60
CAPACITY_SCALE_DOWN_COOLDOWN_SECONDS=600
CAPACITY_SCALE_DOWN_STABILIZATION_SECONDS=900
CAPACITY_SCALE_DOWN_REQUIRED_OBSERVATIONS=5
CAPACITY_SCALE_UP_THRESHOLD_PERCENT=65
CAPACITY_SCALE_DOWN_THRESHOLD_PERCENT=35
CAPACITY_MAX_SCALE_UP_STEP=4
CAPACITY_MAX_SCALE_UP_PERCENT=50
CAPACITY_MAX_SCALE_DOWN_STEP=1
CAPACITY_CONVERGENCE_TIMEOUT_SECONDS=300
CAPACITY_PLAN_ACTIVE_KEY_ID=v1
CAPACITY_PLAN_SIGNING_KEYS={}
CAPACITY_WEB_MIN_INSTANCES=2
CAPACITY_WEB_MAX_INSTANCES=20
CAPACITY_CPU_TARGET_PERCENT=65
CAPACITY_MEMORY_TARGET_PERCENT=70
CAPACITY_DB_SCALE_UP_LIMIT_PERCENT=65
CAPACITY_DB_LOCK_WAIT_LIMIT=0
CAPACITY_DB_SLOW_QUERY_LIMIT=1
CAPACITY_QUEUE_ERROR_LIMIT_PERCENT=2
CAPACITY_REQUIRE_DATABASE_TELEMETRY=true
CAPACITY_OBSERVATION_RETENTION_DAYS=31
CAPACITY_EVIDENCE_RETENTION_DAYS=365
CAPACITY_DECISION_RETENTION_DAYS=30
CAPACITY_PRUNE_BATCH_SIZE=1000
CAPACITY_PRUNE_MAX_BATCHES=10
BACKGROUND_WORKER_AUTOMATION_ENABLED=true
BACKGROUND_WORKER_TARGET_UTILIZATION=70
BACKGROUND_WORKER_HEADROOM_PERCENT=30
BACKGROUND_WORKER_CATCH_UP_SECONDS=300
BACKGROUND_WORKERS_MIN_CRITICAL=2
BACKGROUND_WORKERS_MAX_CRITICAL=12
BACKGROUND_WORKERS_MIN_DOCUMENTS=1
BACKGROUND_WORKERS_MAX_DOCUMENTS=4
BACKGROUND_WORKERS_MIN_NOTIFICATIONS=1
BACKGROUND_WORKERS_MAX_NOTIFICATIONS=8
BACKGROUND_WORKERS_MIN_MEDIA_IMAGE=1
BACKGROUND_WORKERS_MAX_MEDIA_IMAGE=3
BACKGROUND_WORKERS_MIN_MEDIA_VIDEO=1
BACKGROUND_WORKERS_MAX_MEDIA_VIDEO=2
BACKGROUND_WORKERS_MIN_MEDIA_MAINTENANCE=1
BACKGROUND_WORKERS_MAX_MEDIA_MAINTENANCE=2
BACKGROUND_WORKERS_MIN_MAINTENANCE=1
BACKGROUND_WORKERS_MAX_MAINTENANCE=4
BACKGROUND_WORKERS_MIN_DEFAULT=1
BACKGROUND_WORKERS_MAX_DEFAULT=8

REDIS_SESSION_URL=rediss://default:secret-manager-reference@session-redis.internal:6379/0
REDIS_CACHE_URL=rediss://default:secret-manager-reference@cache-redis.internal:6379/0
REDIS_TRAFFIC_URL=rediss://default:secret-manager-reference@traffic-redis.internal:6379/0
REDIS_QUEUE_URL=rediss://default:secret-manager-reference@queue-redis.internal:6379/0
REDIS_COORDINATION_URL=rediss://default:secret-manager-reference@coordination-redis.internal:6379/0
REDIS_SESSION_DB=0
REDIS_CACHE_DB=0
REDIS_TRAFFIC_DB=0
REDIS_QUEUE_DB=0
REDIS_COORDINATION_DB=0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_READ_TIMEOUT_SECONDS=2
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_READ_TIMEOUT_SECONDS=6
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_MANAGED_SERVICE=true
REDIS_HA_ENABLED=true
REDIS_AUTOMATIC_FAILOVER=true
REDIS_HA_TOPOLOGY=replicated
REDIS_HA_MIN_REPLICAS=1
REDIS_TLS_REQUIRED=true
REDIS_TLS_VERIFY_PEER=true
# Leave empty when the provider chain is trusted by the operating system.
REDIS_TLS_CA=
REDIS_AUTH_REQUIRED=true
REDIS_REQUIRE_DEDICATED_ENDPOINTS=true
REDIS_SESSION_MAXMEMORY_POLICY=noeviction
REDIS_CACHE_MAXMEMORY_POLICY=allkeys-lru
# LFU retains repeatedly-hit abusive counters better than one-off random keys
# while keeping limiter cardinality physically isolated from business state.
REDIS_TRAFFIC_MAXMEMORY_POLICY=allkeys-lfu
REDIS_QUEUE_MAXMEMORY_POLICY=noeviction
REDIS_COORDINATION_MAXMEMORY_POLICY=noeviction
REDIS_QUEUE_PERSISTENCE=provider_managed

# Durable user-generated files must be reachable from every application node.
# Bucket policies, encryption, versioning, lifecycle, and credentials remain
# infrastructure responsibilities; Laravel keeps stable logical disk names.
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
S3_CONNECT_TIMEOUT_SECONDS=3
S3_REQUEST_TIMEOUT_SECONDS=10
S3_MAX_RETRIES=2
FILESYSTEM_DISK=s3
MEDIA_DISK=public
PUBLIC_STORAGE_DRIVER=s3
PUBLIC_STORAGE_AWS_BUCKET=ubsc-public-media
PUBLIC_STORAGE_URL=https://media.ubsportcenter.co.id
PUBLIC_STORAGE_THROW=true
IDENTITY_DOCUMENTS_DRIVER=s3
IDENTITY_DOCUMENTS_AWS_BUCKET=ubsc-private-identities
IDENTITY_DOCUMENTS_THROW=true
AWS_BUCKET=ubsc-private-gallery
GALLERY_ORIGINALS_DISK=s3
GALLERY_STAGING_DISK=s3
GALLERY_PUBLIC_DISK=public
INVOICE_PDF_DISK=invoice-pdf-s3
INVOICE_PDF_AWS_BUCKET=ubsc-private-invoices
INVOICE_PDF_STORAGE_THROW=true
INVOICE_PDF_PREWARM_ENABLED=true
INVOICE_PDF_ALLOW_SYNCHRONOUS_FALLBACK=false

# Liveness is /up. Readiness removes only an unhealthy node from traffic. When
# replication enforcement is active, the database adapter also verifies signed
# single-writer/quorum/fencing safety; this cannot be omitted from this list.
# Replica lag/capacity, queue, and object-storage failures remain incident
# signals so a healthy proven writer can keep core reads/bookings available.
MONITORING_READINESS_REQUIRED_CHECKS=database,cache,sessions,locks,traffic
MONITORING_READINESS_ADVISORY_CHECKS=
MONITORING_READINESS_DEEP_CHECKS=queues,storage
MONITORING_READINESS_CACHE_WRITE_PROBE=true
MONITORING_READINESS_ATTEMPTS=1
MONITORING_READINESS_TOTAL_BUDGET_MS=4000
MONITORING_READINESS_STORAGE_DISK=s3
MONITORING_READINESS_STORAGE_SENTINEL=.health/ready-v1
SAFE_RETRY_ATTEMPTS=2
SAFE_RETRY_BASE_DELAY_MS=25
SAFE_RETRY_MAX_DELAY_MS=100
SAFE_RETRY_JITTER_MS=15

EXTERNAL_MONITORING_ENABLED=true
EXTERNAL_MONITORING_PROVIDER=github-actions
EXTERNAL_MONITORING_URL=https://ubsportcenter.co.id/health/ready
EXTERNAL_MONITORING_INTERVAL_SECONDS=300
EXTERNAL_MONITORING_MAX_HEALTHY_LATENCY_MS=5000
EXTERNAL_MONITORING_INGEST_ENABLED=true
# Required secret-manager value. The matching raw/base64 key is also stored as
# UBSC_EXTERNAL_SLI_SIGNING_KEY in GitHub Actions, with key ID v1.
EXTERNAL_MONITORING_INGEST_KEYS={}
EXTERNAL_MONITORING_INGEST_MAX_BODY_BYTES=16384
EXTERNAL_MONITORING_INGEST_CLOCK_SKEW_SECONDS=300
EXTERNAL_MONITORING_MAX_PROBE_DURATION_SECONDS=180

# The application cannot observe its own total outage. Configure these
# providers first, then set the declarations true and pass the strict gate.
OBSERVABILITY_REQUEST_ID_ENABLED=true
OBSERVABILITY_LOG_EXPORT_ENABLED=true
OBSERVABILITY_LOG_EXPORT_PROVIDER=replace-with-managed-log-provider
OBSERVABILITY_STRUCTURED_LOGS=true
OBSERVABILITY_LOG_RECEIPTS_ENABLED=true
OBSERVABILITY_LOG_RECEIPT_PROVIDER=replace-with-managed-log-provider
OBSERVABILITY_LOG_RECEIPT_ACTIVE_KEY_IDS=log-sink-v1
# Public RSA/ECDSA keys only. The log-provider adapter retains the private key.
OBSERVABILITY_LOG_RECEIPT_VERIFYING_KEYS={}
OBSERVABILITY_LOG_RECEIPT_MAX_BYTES=32768
OBSERVABILITY_LOG_RECEIPT_MAX_AGE_SECONDS=600
OBSERVABILITY_LOG_RECEIPT_CLOCK_SKEW_SECONDS=120
OBSERVABILITY_LOG_MIN_RETENTION_DAYS=90
OBSERVABILITY_LOG_RECEIPT_WAIT_SECONDS=60
OBSERVABILITY_LOG_RECEIPT_POLL_MS=500
OBSERVABILITY_LOG_RECEIPT_WARNING_SECONDS=90000
OBSERVABILITY_LOG_RECEIPT_OUTAGE_SECONDS=172800
OBSERVABILITY_EXTERNAL_SLI_CONNECTED=false
OBSERVABILITY_SECURITY_EVENTS_CONNECTED=true
OBSERVABILITY_APM_CONNECTED=false

MONITORING_SLO_WINDOW_DAYS=28
MONITORING_SLO_MINIMUM_SAMPLES=60
MONITORING_SLO_INTERNAL_TARGET=99.9
MONITORING_SLO_AVAILABILITY_TARGET=99.9
MONITORING_SLO_BOOKING_TARGET=99.9
MONITORING_SLO_LATENCY_TARGET=99
MONITORING_SLO_LATENCY_THRESHOLD_MS=800
MONITORING_SLO_FAST_BURN_1H=14.4
MONITORING_SLO_FAST_BURN_6H=6
MONITORING_SLO_SLOW_BURN_6H=6
MONITORING_SLO_SLOW_BURN_24H=3

MONITORING_ALERT_CHANNELS=log,webhook
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_SECRET=
MONITORING_ALERT_CANARY_REUSE_SECONDS=600
MONITORING_ALERT_DISPATCHER_WARNING_SECONDS=180
MONITORING_ALERT_DISPATCHER_OUTAGE_SECONDS=600
MONITORING_ALERT_PENDING_WARNING=25
MONITORING_ALERT_PENDING_OUTAGE=100
MONITORING_ALERT_OLDEST_WARNING_SECONDS=300
MONITORING_ALERT_OLDEST_OUTAGE_SECONDS=900
MONITORING_ALERT_OFF_HOST_WARNING_SECONDS=90000
MONITORING_ALERT_OFF_HOST_OUTAGE_SECONDS=172800
MONITORING_BACKUP_HEARTBEAT_ENABLED=true
MONITORING_BACKUP_WARNING_SECONDS=108000
MONITORING_BACKUP_OUTAGE_SECONDS=172800
