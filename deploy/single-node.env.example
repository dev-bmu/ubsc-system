# UBSC single-node production overlay.
#
# Merge this file with secrets from the hosting secret inventory. Never copy
# placeholder values into production and never commit the resulting .env.
# One VPS is a supported production profile, but it is not high availability.
# Multi-node code remains installed and dormant until PRODUCTION_TOPOLOGY is
# explicitly changed to multi_node and its strict infrastructure gates pass.
# Adding a VPS never changes this automatically. Follow
# docs/operations/07-PERUBAHAN-MODE-INFRASTRUKTUR.md before changing topology.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://ubsportcenter.co.id
APP_RELEASE=replace-with-immutable-release-id
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=coordination

# Active runtime profile.
PRODUCTION_CONTRACT_ENFORCE=true
SINGLE_NODE_CONTRACT_ENFORCE=true
PRODUCTION_TOPOLOGY=single_node
PRODUCTION_APP_INSTANCES=1
PRODUCTION_INSTANCE_ID=ubsc-single-01

# These gates remain present but config makes them dormant in single_node.
# When topology becomes multi_node they wake and fail closed until every real
# provider capability/evidence value has also been supplied.
HIGH_AVAILABILITY_CONTRACT_ENFORCE=true
DATABASE_REPLICATION_CONTRACT_ENFORCE=true
DEPLOYMENT_CONTRACT_ENFORCE=true
DDOS_PROTECTION_CONTRACT_ENFORCE=true
DISASTER_RECOVERY_CONTRACT_ENFORCE=true
OBSERVABILITY_CONTRACT_ENFORCE=true
CAPACITY_PLANNING_ENFORCE=true
RESILIENCE_DRILLS_ENFORCE=true

# Process recovery remains active in both profiles.
PROCESS_SUPERVISION_ENFORCE=true
PROCESS_SUPERVISOR_CONFIG_PATH=/etc/supervisor/conf.d/ubsc.conf
PROCESS_SUPERVISION_MAX_CLOCK_SKEW_SECONDS=30

# Immutable atomic single-VPS release layout.
DEPLOYMENT_STRATEGY=atomic_single_node
DEPLOYMENT_ORCHESTRATOR_PROVIDER=hostinger-vps
DEPLOYMENT_IMMUTABLE_RELEASES=true
DEPLOYMENT_ATOMIC_TRAFFIC_SWITCH=true
DEPLOYMENT_HEALTH_GATED=true
DEPLOYMENT_CONNECTION_DRAINING=false
DEPLOYMENT_AUTOMATIC_APP_ROLLBACK=true
DEPLOYMENT_MAX_UNAVAILABLE=1
DEPLOYMENT_MIN_HEALTHY_INSTANCES=1
DEPLOYMENT_RETAINED_RELEASES=5
DEPLOYMENT_EXPAND_CONTRACT_REQUIRED=true
DEPLOYMENT_SCHEMA_BACKWARD_COMPATIBLE_RELEASES=2
DEPLOYMENT_AUTOMATIC_DB_ROLLBACK=false
DEPLOYMENT_APP_ROOT=/srv/ubsc
DEPLOYMENT_RELEASES_ROOT=/srv/ubsc/releases
DEPLOYMENT_CURRENT_LINK=/srv/ubsc/current
DEPLOYMENT_LOCAL_READINESS_URL=http://127.0.0.1:8080/health/ready
DEPLOYMENT_LOCK_TIMEOUT_SECONDS=1800
DEPLOYMENT_COMMAND_TIMEOUT_SECONDS=900
ACTIVATE_RELEASE_COMMAND_TIMEOUT_SECONDS=600
PRODUCTION_READINESS_COMMAND_TIMEOUT_SECONDS=300
DEPLOYMENT_MINIMUM_DISK_FREE_PERCENT=15
SINGLE_NODE_PERSISTENT_STORAGE_ROOT=/srv/ubsc/shared/storage
SINGLE_NODE_RELEASE_STORAGE_LINKED=true
# Absolute root-owned adapter executable by the deploy user through one narrow
# sudoers rule. Example behavior: validate release path, then reload PHP-FPM.
SINGLE_NODE_RUNTIME_RELOAD_HOOK=/usr/local/libexec/ubsc-reload-runtime

# Public managed edge. Replace provider with the real service identity.
EDGE_PROVIDER=replace-with-real-edge-provider
EDGE_MANAGED_DNS=true
EDGE_CDN_ENABLED=true
EDGE_WAF_ENABLED=true
EDGE_DDOS_PROTECTION=true
EDGE_TLS_TERMINATION=true
EDGE_ORIGIN_TLS=true
EDGE_ORIGIN_ACCESS_RESTRICTED=true
EDGE_CERTIFICATE_AUTO_RENEWAL=true
EDGE_MINIMUM_TLS_VERSION=1.2
EDGE_HEALTH_PATH=/health/ready

# There is no application-node load balancer yet; never fake it.
LOAD_BALANCER_ENABLED=false
LOAD_BALANCER_MANAGED_SERVICE=false
LOAD_BALANCER_HA_ENABLED=false
LOAD_BALANCER_AUTOMATIC_FAILOVER=false
LOAD_BALANCER_EXPOSE_INSTANCE_HEADER=false
LOAD_BALANCER_EXPOSE_RELEASE_HEADER=true
LOAD_BALANCER_FORWARDED_FOR_MODE=
LOAD_BALANCER_READINESS_EDGE_PROTECTED=true

# Local MariaDB writer. Supply real secrets outside source control. Bind the
# server to loopback, use InnoDB, enable row binlog, and never use root here.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ubsc
DB_USERNAME=replace-with-dedicated-app-user
DB_PASSWORD=replace-with-secret-manager-value
DB_CONNECT_TIMEOUT_SECONDS=3
DB_TRANSACTION_ATTEMPTS=3
DB_MANAGED_SERVICE=false
DB_HA_ENABLED=false
DB_AUTOMATIC_FAILOVER=false
DB_TLS_REQUIRED=false
DB_TLS_VERIFY_PEER=false

# Replication declarations may be prepared in advance, but config keeps the
# feature dormant until multi_node. No reader is used for transactional data.
DB_REPLICATION_ENABLED=true
DB_REPLICA_READS_ENABLED=false
DB_REPLICATION_AUTOMATIC_FAILOVER=false
DB_REPLICATION_AUTOMATIC_FAILBACK=false

# One local Redis service, five isolated logical DBs. The server itself must
# bind loopback, require authentication, use AOF everysec, and apply noeviction
# to critical state. Declarations below are verified by the release gate.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-secret-manager-value
REDIS_AUTH_REQUIRED=true
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_READ_TIMEOUT_SECONDS=2
REDIS_QUEUE_READ_TIMEOUT_SECONDS=6
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_SESSION_DB=3
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_COORDINATION_DB=4
REDIS_TRAFFIC_DB=5
REDIS_SESSION_MAXMEMORY_POLICY=noeviction
REDIS_CACHE_MAXMEMORY_POLICY=allkeys-lru
REDIS_TRAFFIC_MAXMEMORY_POLICY=allkeys-lfu
REDIS_QUEUE_MAXMEMORY_POLICY=noeviction
REDIS_COORDINATION_MAXMEMORY_POLICY=noeviction
REDIS_QUEUE_PERSISTENCE=aof_everysec
REDIS_MANAGED_SERVICE=false
REDIS_HA_ENABLED=false
REDIS_AUTOMATIC_FAILOVER=false

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_LIMITER_STORE=traffic
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=coordination
REDIS_TRAFFIC_CONNECTION=traffic
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_LONG_RETRY_AFTER=1200
QUEUE_AFTER_COMMIT=true

# Every local disk below resolves through release/storage -> shared/storage.
# Fail loudly: silent write failures are forbidden in production.
FILESYSTEM_DISK=local
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
PUBLIC_STORAGE_DRIVER=local
PUBLIC_STORAGE_THROW=true
PUBLIC_STORAGE_REPORT=true
IDENTITY_DOCUMENTS_DRIVER=local
IDENTITY_DOCUMENTS_THROW=true
IDENTITY_DOCUMENTS_REPORT=true
INVOICE_PDF_DISK=invoice-pdf
INVOICE_PDF_STORAGE_THROW=true
INVOICE_PDF_STORAGE_REPORT=true
MEDIA_DISK=public
GALLERY_ORIGINALS_DISK=local
GALLERY_STAGING_DISK=local
GALLERY_PUBLIC_DISK=public
MONITORING_READINESS_STORAGE_DISK=local
MONITORING_READINESS_STORAGE_SENTINEL=health/readiness-v1.txt

# Application layer remains active even though the managed multi-node DDoS
# contract is dormant. The edge must strip spoofed identity headers and block
# direct origin traffic.
APPLICATION_TRAFFIC_PROTECTION_ENABLED=true
REQUEST_RESOURCE_ENVELOPE_ENABLED=true
DDOS_EDGE_ALWAYS_ON=true
DDOS_EDGE_GLOBAL_SCRUBBING=true
DDOS_EDGE_L3_L4_AUTOMATIC=true
DDOS_EDGE_L7_AUTOMATIC=true
DDOS_EDGE_MANAGED_WAF_RULES=true
DDOS_EDGE_ADAPTIVE_RATE_LIMITING=true
DDOS_EDGE_BOT_MANAGEMENT=true
DDOS_EDGE_STATIC_ASSET_CACHE=true
DDOS_EDGE_PRIVATE_HTML_BYPASS=true
DDOS_ORIGIN_DIRECT_ACCESS_DISABLED=true
DDOS_ORIGIN_IP_DISCLOSURE_PREVENTED=true
DDOS_ORIGIN_AUTHENTICATION_MODE=provider_authenticated_pull
DDOS_VERIFIED_CLIENT_IP_HEADER=x-verified-client-ip
DDOS_EDGE_STRIPS_SPOOFED_IP_HEADERS=true
DDOS_LB_REPLACES_FORWARDED_FOR=false
DDOS_SECURITY_EVENT_STREAM_ENABLED=true
DDOS_ATTACK_ALERTING_ENABLED=true
DDOS_ORIGIN_SATURATION_ALERTING_ENABLED=true
DDOS_COST_ANOMALY_ALERTING_ENABLED=true
DDOS_EMERGENCY_MODE_AVAILABLE=true
DDOS_PROVIDER_ESCALATION_CONFIGURED=true
DDOS_RESPONSE_RUNBOOK=docs/DDOS_RESPONSE_OPERATIONS.md
DDOS_PROVIDER_RESPONSE_SLA_SECONDS=900
DDOS_EXERCISE_INTERVAL_DAYS=90

# Database-only recovery: daily encrypted immutable off-site backup plus
# continuously shipped binlog. Media/content stay on persistent storage and
# use their own independent storage backup/versioning policy.
SINGLE_NODE_EXTERNAL_BACKUP_RUNNER=true
SINGLE_NODE_BINLOG_ARCHIVING=true
RECOVERY_POINT_OBJECTIVE_SECONDS=300
RECOVERY_TIME_OBJECTIVE_SECONDS=3600
DB_PITR_ENABLED=true
DB_PITR_PROVIDER_MANAGED=false
DB_PITR_CONTINUOUS=true
DB_PITR_RETENTION_DAYS=14
DB_PITR_OBSERVATION_ENABLED=true
DB_PITR_OBSERVATION_WARNING_SECONDS=600
DB_PITR_OBSERVATION_OUTAGE_SECONDS=1200
DB_IMMUTABLE_BACKUP_ENABLED=true
DB_BACKUP_SCOPE=database
DB_BACKUP_ENCRYPTED=true
DB_BACKUP_OFFSITE=true
DB_BACKUP_CROSS_ACCOUNT=false
DB_BACKUP_CROSS_REGION=false
DB_BACKUP_IMMUTABLE=true
DB_BACKUP_OBJECT_LOCK_MODE=compliance
DB_BACKUP_RETENTION_DAYS=35
DB_BACKUP_EXPECTED_INTERVAL_SECONDS=86400
RESTORE_DRILL_ENABLED=true
RESTORE_DRILL_INTERVAL_DAYS=90
RESTORE_DRILL_GRACE_DAYS=14
RESTORE_DRILL_ISOLATED_TARGET_REQUIRED=true
RESTORE_DRILL_PRODUCTION_TARGET_FORBIDDEN=true
# Independent attestation may be enabled once an external verifier/key service
# exists. Never claim it before that infrastructure is real.
RECOVERY_ATTESTATION_REQUIRED=false

# Internal cockpit plus independent public monitoring. The external monitor
# must run outside this VPS, otherwise it disappears with the outage.
MONITORING_ENABLED=true
MONITORING_READINESS_REQUIRED_CHECKS=database,cache,locks
MONITORING_READINESS_ADVISORY_CHECKS=traffic
MONITORING_READINESS_DEEP_CHECKS=queues,storage
MONITORING_READINESS_CACHE_WRITE_PROBE=true
MONITORING_READINESS_ATTEMPTS=1
MONITORING_READINESS_TOTAL_BUDGET_MS=4000
MONITORING_BACKUP_HEARTBEAT_ENABLED=true
MONITORING_BACKUP_WARNING_SECONDS=108000
MONITORING_BACKUP_OUTAGE_SECONDS=172800
EXTERNAL_MONITORING_ENABLED=true
EXTERNAL_MONITORING_PROVIDER=replace-with-independent-monitor
EXTERNAL_MONITORING_URL=https://ubsportcenter.co.id/health/ready
EXTERNAL_MONITORING_INTERVAL_SECONDS=300
EXTERNAL_MONITORING_MAX_HEALTHY_LATENCY_MS=5000
EXTERNAL_MONITORING_INGEST_ENABLED=true
EXTERNAL_MONITORING_INGEST_KEYS={"monitor-v1":"replace-with-independent-32-byte-secret"}
EXTERNAL_MONITORING_INGEST_MAX_BODY_BYTES=16384
EXTERNAL_MONITORING_INGEST_CLOCK_SKEW_SECONDS=300
EXTERNAL_MONITORING_MAX_PROBE_DURATION_SECONDS=180
OBSERVABILITY_EXTERNAL_SLI_CONNECTED=true
OBSERVABILITY_LOG_EXPORT_ENABLED=true
OBSERVABILITY_LOG_EXPORT_PROVIDER=replace-with-real-off-host-log-provider
OBSERVABILITY_STRUCTURED_LOGS=true
LOG_CHANNEL=stack
LOG_STACK=daily,json_stderr
LOG_LEVEL=info
MONITORING_ALERT_CHANNELS=log,webhook
MONITORING_ALERT_WEBHOOK_URL=https://replace-with-real-alert-endpoint.example/ubsc
MONITORING_ALERT_WEBHOOK_SECRET=replace-with-independent-secret

# Local signed recovery ledger keys are secrets and must come from the secret
# inventory. Retain old versioned keys during rotation.
RECOVERY_EVIDENCE_ACTIVE_KEY_ID=single-recovery-v1
RECOVERY_EVIDENCE_SIGNING_KEYS={"single-recovery-v1":"replace-with-32-byte-or-longer-secret"}

# Installed but asleep until multi_node. Keeping declarations here makes the
# activation boundary explicit; no application code has to be restored later.
CAPACITY_PLANNING_ENABLED=true
RESILIENCE_DRILLS_ENABLED=true
