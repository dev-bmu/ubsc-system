; UB Sport Center - database queue production baseline
; Install this same artifact on every application/worker node after replacing
; APP_DIRECTORY and RUN_AS_USER. Every node runs one scheduler; distributed
; onOneServer locks elect the executor and preserve failover without duplicates.

[group:ubsc]
programs=ubsc-scheduler,ubsc-critical,ubsc-documents,ubsc-notifications,ubsc-maintenance,ubsc-media-maintenance,ubsc-default,ubsc-media-image,ubsc-media-video
priority=100

[program:ubsc-scheduler]
directory=APP_DIRECTORY
command=/usr/bin/php artisan schedule:work --no-interaction
user=RUN_AS_USER
numprocs=1
autostart=true
autorestart=true
startsecs=3
startretries=10
stopsignal=TERM
stopasgroup=true
killasgroup=true
stopwaitsecs=30
redirect_stderr=true
stdout_logfile=APP_DIRECTORY/storage/logs/supervisor-scheduler.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5

[program:ubsc-critical]
process_name=%(program_name)s_%(process_num)02d
directory=APP_DIRECTORY
command=/usr/bin/php artisan queue:work database --queue=critical --sleep=1 --tries=3 --backoff=5 --timeout=80 --max-time=3600 --max-jobs=1000 --memory=256 --no-interaction
user=RUN_AS_USER
numprocs=2
autostart=true
autorestart=true
startsecs=3
startretries=10
stopsignal=TERM
stopasgroup=true
killasgroup=true
stopwaitsecs=120
redirect_stderr=true
stdout_logfile=APP_DIRECTORY/storage/logs/supervisor-critical-%(process_num)02d.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5

[program:ubsc-documents]
process_name=%(program_name)s_%(process_num)02d
directory=APP_DIRECTORY
command=/usr/bin/php artisan queue:work database --queue=documents --sleep=1 --tries=3 --backoff=5 --timeout=80 --max-time=3600 --max-jobs=500 --memory=256 --no-interaction
user=RUN_AS_USER
numprocs=1
autostart=true
autorestart=true
startsecs=3
startretries=10
stopsignal=TERM
stopasgroup=true
killasgroup=true
stopwaitsecs=120
redirect_stderr=true
stdout_logfile=APP_DIRECTORY/storage/logs/supervisor-documents-%(process_num)02d.log
