# Capacity provider adapter contract (non-secret template).
#
# Copy this file into the provider adapter's secret/configuration boundary.
# Replace every "replace-with-*" value during deployment and inject the plan
# verification key ring from a secret manager. Never source this file directly
# in production while placeholders or an empty key ring remain.

APP_RELEASE=replace-with-immutable-release-id
CAPACITY_TARGET_ENVIRONMENT=production
CAPACITY_INFRASTRUCTURE_PROFILE=replace-with-immutable-capacity-profile
CAPACITY_PLATFORM_PROVIDER=replace-with-provider-adapter-id

CAPACITY_MANAGED_TARGETS=web,queue:critical,queue:documents,queue:notifications,queue:media_image,queue:media_video,queue:media_maintenance,queue:maintenance,queue:default
CAPACITY_REQUIRED_EVIDENCE_SCOPES=public_read,booking_checkout,admin,authentication,write

CAPACITY_SCALE_DOWN_THRESHOLD_PERCENT=35
CAPACITY_MAX_SCALE_UP_STEP=4
CAPACITY_MAX_SCALE_UP_PERCENT=50
CAPACITY_MAX_SCALE_DOWN_STEP=1

# This map is deliberately maintained by deployment/IaC rather than copied
# from a signed plan. Every managed target must be present exactly once.
CAPACITY_TARGET_BOUNDS='{"web":{"minimum_instances":2,"maximum_instances":20},"queue:critical":{"minimum_instances":2,"maximum_instances":12},"queue:documents":{"minimum_instances":1,"maximum_instances":4},"queue:notifications":{"minimum_instances":1,"maximum_instances":8},"queue:media_image":{"minimum_instances":1,"maximum_instances":3},"queue:media_video":{"minimum_instances":1,"maximum_instances":2},"queue:media_maintenance":{"minimum_instances":1,"maximum_instances":2},"queue:maintenance":{"minimum_instances":1,"maximum_instances":4},"queue:default":{"minimum_instances":1,"maximum_instances":8}}'

# Inject a JSON key ring from the provider secret manager. Keep the previous
# verification key only until every plan signed by it has expired.
CAPACITY_PLAN_VERIFYING_KEYS='{}'
