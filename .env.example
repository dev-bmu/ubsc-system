PAYMENT_RECOVERY_JOB_TIMEOUT_SECONDS=55
PAYMENT_RECOVERY_JOB_UNIQUE_SECONDS=90
BACKGROUND_QUEUE_SAMPLE_LIMIT=1000
BACKGROUND_QUEUE_WARNING_DEPTH=50
BACKGROUND_QUEUE_OUTAGE_DEPTH=250
BACKGROUND_QUEUE_WARNING_SECONDS=120
BACKGROUND_QUEUE_OUTAGE_SECONDS=600
BACKGROUND_WORKER_AUTOMATION_ENABLED=false
BACKGROUND_WORKER_TARGET_UTILIZATION=70
BACKGROUND_WORKER_HEADROOM_PERCENT=30
BACKGROUND_WORKER_CATCH_UP_SECONDS=300
