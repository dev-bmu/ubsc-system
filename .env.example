# Priority lanes keep customer-critical reconciliation and notifications from
# waiting behind expensive media work. Production runs one supervised program
# per lane; never pool these queue names into a shared worker.
BACKGROUND_JOB_CONNECTION=database
BACKGROUND_MEDIA_CONNECTION=database-long
BACKGROUND_QUEUE_CRITICAL=critical
BACKGROUND_QUEUE_DOCUMENTS=documents
BACKGROUND_QUEUE_NOTIFICATIONS=notifications
BACKGROUND_QUEUE_MEDIA_IMAGE=media-image
BACKGROUND_QUEUE_MEDIA_VIDEO=media-video
BACKGROUND_QUEUE_MEDIA_MAINTENANCE=media-maintenance
BACKGROUND_QUEUE_MAINTENANCE=maintenance
BACKGROUND_QUEUE_DEFAULT=default
