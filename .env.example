ADMIN_MFA_PREAUTH_MINUTES=5
ADMIN_MFA_MANAGEMENT_STEP_UP_MINUTES=5
ADMIN_MFA_MANAGEMENT_CEREMONY_MINUTES=10
ADMIN_MFA_CHALLENGE_SECONDS=90
ADMIN_MFA_TOTP_ISSUER="UB Sport Center"
AUTH_LOGIN_TIMEBOX_MS=1000
PASSWORD_RECOVERY_TIMEBOX_MS=1000
# Keep this independent and stable across APP_KEY rotations.
ADMIN_MFA_RECOVERY_PEPPER=
# Keep this stable across APP_KEY rotations. Generate with: php artisan key:generate --show
PASSKEYS_USER_HANDLE_SECRET=
# Production: exact HTTPS origin and bare domain, without paths or wildcards.
