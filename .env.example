APP_NAME="UB Sport Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Only explicit IPs/CIDRs of reverse proxies you operate. Wildcards,
# REMOTE_ADDR, 0.0.0.0/0 and ::/0 are intentionally rejected outside local/testing.
TRUSTED_PROXIES=
PUBLIC_STORAGE_URL=/storage
APP_TIMEZONE=Asia/Jakarta

# Local defaults. Production chooses exactly one reviewed overlay:
# deploy/single-node.env.example or deploy/production.env.example. Both must
# pass `php artisan production:check --strict --probe`; multi_node additionally
# runs the HA/replication/fleet gates.
PRODUCTION_CONTRACT_ENFORCE=false
SINGLE_NODE_CONTRACT_ENFORCE=false
HIGH_AVAILABILITY_CONTRACT_ENFORCE=false
DATABASE_REPLICATION_CONTRACT_ENFORCE=false
DEPLOYMENT_CONTRACT_ENFORCE=false
PROCESS_SUPERVISION_ENFORCE=false
DISASTER_RECOVERY_CONTRACT_ENFORCE=false
OBSERVABILITY_CONTRACT_ENFORCE=false
PROCESS_SUPERVISOR_CONFIG_PATH=
PROCESS_SUPERVISION_MAX_CLOCK_SKEW_SECONDS=30
PRODUCTION_TOPOLOGY=local
PRODUCTION_APP_INSTANCES=1
PRODUCTION_INSTANCE_ID=local-app-01
SINGLE_NODE_PERSISTENT_STORAGE_ROOT=/srv/ubsc/shared/storage
SINGLE_NODE_RELEASE_STORAGE_LINKED=false
SINGLE_NODE_EXTERNAL_BACKUP_RUNNER=false
SINGLE_NODE_BINLOG_ARCHIVING=false
SINGLE_NODE_RUNTIME_RELOAD_HOOK=
LOAD_BALANCER_ENABLED=false
LOAD_BALANCER_MANAGED_SERVICE=false
LOAD_BALANCER_HA_ENABLED=false
LOAD_BALANCER_AUTOMATIC_FAILOVER=false
LOAD_BALANCER_FAILOVER_RTO_SECONDS=0
LOAD_BALANCER_MIN_FAILURE_DOMAINS=1
LOAD_BALANCER_HEALTH_PATH=/health/ready
LOAD_BALANCER_EXPOSE_INSTANCE_HEADER=true
LOAD_BALANCER_EXPOSE_RELEASE_HEADER=true
LOAD_BALANCER_FORWARDED_FOR_MODE=
LOAD_BALANCER_READINESS_EDGE_PROTECTED=false
LOAD_BALANCER_STICKY_SESSIONS=false
LOAD_BALANCER_HEALTH_INTERVAL_SECONDS=5
LOAD_BALANCER_HEALTH_TIMEOUT_SECONDS=5
LOAD_BALANCER_CONNECTION_DRAIN_SECONDS=30

# Atomic rollout and managed edge. Local development deliberately leaves
# these controls disabled; production values live in deploy/production.env.example.
DEPLOYMENT_STRATEGY=local
DEPLOYMENT_ORCHESTRATOR_PROVIDER=
DEPLOYMENT_IMMUTABLE_RELEASES=false
DEPLOYMENT_ATOMIC_TRAFFIC_SWITCH=false
DEPLOYMENT_HEALTH_GATED=false
DEPLOYMENT_CONNECTION_DRAINING=false
DEPLOYMENT_AUTOMATIC_APP_ROLLBACK=false
DEPLOYMENT_MAX_UNAVAILABLE=0
DEPLOYMENT_MIN_HEALTHY_INSTANCES=1
DEPLOYMENT_RETAINED_RELEASES=3
DEPLOYMENT_EXPAND_CONTRACT_REQUIRED=false
DEPLOYMENT_SCHEMA_BACKWARD_COMPATIBLE_RELEASES=0
DEPLOYMENT_AUTOMATIC_DB_ROLLBACK=false
DEPLOYMENT_APP_ROOT=/srv/ubsc
DEPLOYMENT_RELEASES_ROOT=/srv/ubsc/releases
DEPLOYMENT_CURRENT_LINK=/srv/ubsc/current
DEPLOYMENT_LOCAL_READINESS_URL=http://127.0.0.1:8080/health/ready
DEPLOYMENT_LOCK_TIMEOUT_SECONDS=1800
DEPLOYMENT_CONNECTION_DRAIN_SECONDS=30
DEPLOYMENT_COMMAND_TIMEOUT_SECONDS=900
EDGE_PROVIDER=
EDGE_MANAGED_DNS=false
EDGE_CDN_ENABLED=false
EDGE_WAF_ENABLED=false
EDGE_DDOS_PROTECTION=false
EDGE_TLS_TERMINATION=false
EDGE_ORIGIN_TLS=false
EDGE_ORIGIN_ACCESS_RESTRICTED=false
EDGE_CERTIFICATE_AUTO_RENEWAL=false
EDGE_MINIMUM_TLS_VERSION=
EDGE_HEALTH_PATH=/health/ready

# Layered DoS/DDoS protection. Application controls limit resource abuse;
# managed edge controls are mandatory before production traffic is accepted.
DDOS_PROTECTION_CONTRACT_ENFORCE=false
APPLICATION_TRAFFIC_PROTECTION_ENABLED=true
REQUEST_RESOURCE_ENVELOPE_ENABLED=true
REQUEST_MAX_TARGET_BYTES=4096
REQUEST_MAX_QUERY_BYTES=2048
REQUEST_MAX_QUERY_PARAMETERS=100
REQUEST_MAX_QUERY_DEPTH=8
REQUEST_MAX_HEADER_COUNT=96
REQUEST_MAX_HEADER_BYTES=32768
REQUEST_MAX_COOKIE_BYTES=8192
REQUEST_DEFAULT_BODY_BYTES=2097152
TRAFFIC_WEB_IP_RPS=40
TRAFFIC_WEB_IP_RPM=1200
TRAFFIC_WEB_NETWORK_RPM=12000
TRAFFIC_WEB_GLOBAL_RPS=600
TRAFFIC_WEB_GLOBAL_RPM=24000
TRAFFIC_REGISTER_IP_15M=5
TRAFFIC_REGISTER_NETWORK_HOUR=100
TRAFFIC_REGISTER_GLOBAL_RPM=300
TRAFFIC_REVIEW_ACTOR_HOUR=10
TRAFFIC_REVIEW_IP_HOUR=60
TRAFFIC_OAUTH_IP_RPM=60
TRAFFIC_OAUTH_NETWORK_RPM=600
TRAFFIC_SITEMAP_IP_RPM=30
TRAFFIC_SITEMAP_GLOBAL_RPM=1000
TRAFFIC_ANALYTICS_IP_RPM=180
TRAFFIC_ANALYTICS_NETWORK_RPM=3000
DDOS_EDGE_ALWAYS_ON=false
DDOS_EDGE_GLOBAL_SCRUBBING=false
DDOS_EDGE_L3_L4_AUTOMATIC=false
DDOS_EDGE_L7_AUTOMATIC=false
DDOS_EDGE_MANAGED_WAF_RULES=false
DDOS_EDGE_ADAPTIVE_RATE_LIMITING=false
DDOS_EDGE_BOT_MANAGEMENT=false
DDOS_EDGE_STATIC_ASSET_CACHE=false
DDOS_EDGE_PRIVATE_HTML_BYPASS=false
DDOS_ORIGIN_DIRECT_ACCESS_DISABLED=false
DDOS_ORIGIN_IP_DISCLOSURE_PREVENTED=false
DDOS_ORIGIN_AUTHENTICATION_MODE=
DDOS_VERIFIED_CLIENT_IP_HEADER=
DDOS_EDGE_STRIPS_SPOOFED_IP_HEADERS=false
DDOS_LB_REPLACES_FORWARDED_FOR=false
DDOS_SECURITY_EVENT_STREAM_ENABLED=false
DDOS_ATTACK_ALERTING_ENABLED=false
DDOS_ORIGIN_SATURATION_ALERTING_ENABLED=false
DDOS_COST_ANOMALY_ALERTING_ENABLED=false
DDOS_EMERGENCY_MODE_AVAILABLE=false
DDOS_PROVIDER_ESCALATION_CONFIGURED=false
DDOS_RESPONSE_RUNBOOK=
DDOS_PROVIDER_RESPONSE_SLA_SECONDS=0
DDOS_EXERCISE_INTERVAL_DAYS=0
DDOS_PROVIDER_VERIFICATION_MODE=
DDOS_PROVIDER_VERIFY_HOOK=
# SHA-256 of the exact provider zone/site ID (non-secret). Generate without a
# trailing newline: printf '%s' 'exact-zone-id' | sha256sum
DDOS_PROVIDER_ZONE_FINGERPRINT=
DDOS_EDGE_RESPONSE_HEADER=
DDOS_PROVIDER_VERIFY_TIMEOUT_SECONDS=30

# Dedicated HMAC key for the append-only booking/membership audit ledger.
# Generate independently from APP_KEY and retain old versioned keys on rotation.
DATA_AUDIT_CURRENT_KEY_VERSION=1
DATA_AUDIT_INTEGRITY_KEY_V1=
DATA_AUDIT_METADATA_MAX_BYTES=8192
DATA_AUDIT_BASELINE_CHUNK_SIZE=500
DATA_AUDIT_VERIFICATION_BATCH_SIZE=1000
DATA_AUDIT_VERIFICATION_LOCK_SECONDS=300
DATA_AUDIT_VERIFICATION_WARNING_AFTER_SECONDS=900
DATA_AUDIT_VERIFICATION_OUTAGE_AFTER_SECONDS=3600
GALLERY_CANONICAL_ORIGIN=https://ubsportcenter.co.id
SEO_CANONICAL_ORIGIN=https://ubsportcenter.co.id
SCOUT_DRIVER=null
SCOUT_QUEUE=true
SCOUT_PREFIX=ubsc_
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Payment operational logs contain only sanitized event names, opaque record
# identifiers, and aggregate counters. Add stderr/syslog to this stack when
# the production platform ships logs to durable off-host storage.
PAYMENT_LOG_STACK=payment_daily
PAYMENT_LOG_LEVEL=info
PAYMENT_LOG_DAILY_DAYS=45
PAYMENT_LOG_ARCHIVE_AFTER_DAYS=30
PAYMENT_LOG_RETENTION_DAYS=365
# Keep empty to use storage/app/private/payment-log-archive.
PAYMENT_LOG_ARCHIVE_PATH=

# SQLite is suitable for local development only. Use mysql, mariadb, pgsql,
# or sqlsrv outside local/testing so security-critical row locks are enforced.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECT_TIMEOUT_SECONDS=5
DB_TRANSACTION_ATTEMPTS=3
DB_LOCK_WAIT_TIMEOUT_SECONDS=5
DB_MANAGED_SERVICE=false
DB_HA_ENABLED=false
DB_AUTOMATIC_FAILOVER=false
DB_FAILOVER_ENDPOINT_KIND=
DB_HA_MIN_AZS=1
DB_FAILOVER_RTO_SECONDS=0
DB_TLS_REQUIRED=false
DB_TLS_VERIFY_PEER=false
MYSQL_ATTR_SSL_CA=

# Managed single-writer replication. These are disabled for local SQLite/XAMPP.
# Production values are declarations verified against signed provider telemetry;
# they do not create, promote, or fence database infrastructure.
DB_REPLICATION_ENABLED=false
DB_REPLICATION_MANAGED_SERVICE=false
DB_REPLICATION_PROVIDER=
DB_REPLICATION_CLUSTER_ID=
DB_REPLICATION_DATASET_ID=
DB_REPLICATION_ENVIRONMENT=production
DB_REPLICATION_PRIMARY_REGION=
DB_REPLICATION_WRITER_ENDPOINT_ID=
DB_REPLICATION_READER_ENDPOINT_ID=
DB_REPLICATION_INDEPENDENT_OBSERVER=
DB_REPLICATION_MODE=
DB_REPLICATION_SINGLE_WRITER=true
DB_REPLICATION_AUTOMATIC_FAILOVER=false
DB_REPLICATION_AUTOMATIC_FAILBACK=false
DB_REPLICATION_MIN_AZS=1
DB_REPLICATION_MIN_REPLICAS=0
DB_REPLICATION_MIN_SYNC_REPLICAS=0
DB_REPLICATION_QUORUM_REQUIRED=true
DB_REPLICATION_FENCING_REQUIRED=true
DB_REPLICATION_PROMOTION_CATCHUP_REQUIRED=true
DB_REPLICATION_MAX_DATA_LOSS_BYTES=0
DB_REPLICATION_FAILOVER_RTO_SECONDS=0
DB_REPLICATION_GTID_REQUIRED=true
DB_REPLICATION_ROW_BINLOG_REQUIRED=true
