MONITORING_SLO_SLOW_BURN_6H=6
MONITORING_SLO_SLOW_BURN_24H=3
# Local log is a durable fallback, not an off-host pager. In production use
# "log,webhook", an HTTPS endpoint, and an independent 32+ character secret.
MONITORING_ALERT_CHANNELS=log
MONITORING_ALERT_LOG_CHANNEL=
MONITORING_ALERT_BATCH_SIZE=50
MONITORING_ALERT_MAX_ATTEMPTS=8
MONITORING_ALERT_RETRY_BASE_SECONDS=30
MONITORING_ALERT_PROCESSING_STALE_SECONDS=180
MONITORING_ALERT_DELIVERED_RETENTION_DAYS=90
MONITORING_ALERT_DEAD_RETENTION_DAYS=365
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_SECRET=
MONITORING_ALERT_CANARY_REUSE_SECONDS=600
MONITORING_ALERT_CONNECT_TIMEOUT_SECONDS=2
MONITORING_ALERT_TIMEOUT_SECONDS=5
MONITORING_ALERT_DISPATCHER_WARNING_SECONDS=180
MONITORING_ALERT_DISPATCHER_OUTAGE_SECONDS=600
MONITORING_ALERT_PENDING_WARNING=25
MONITORING_ALERT_PENDING_OUTAGE=100
MONITORING_ALERT_OLDEST_WARNING_SECONDS=300
MONITORING_ALERT_OLDEST_OUTAGE_SECONDS=900
MONITORING_ALERT_OFF_HOST_WARNING_SECONDS=90000
MONITORING_ALERT_OFF_HOST_OUTAGE_SECONDS=172800
# Enable only after the external backup job calls monitoring:backup-verified
# after verifying both archive readability and its SHA-256 checksum.
MONITORING_BACKUP_HEARTBEAT_ENABLED=false
MONITORING_BACKUP_WARNING_SECONDS=108000
MONITORING_BACKUP_OUTAGE_SECONDS=172800

# Production observability is fail-closed. Enable these declarations only
# after the corresponding off-host service and log drain have been verified.
OBSERVABILITY_REQUEST_ID_ENABLED=true
OBSERVABILITY_LOG_EXPORT_ENABLED=false
OBSERVABILITY_LOG_EXPORT_PROVIDER=
OBSERVABILITY_STRUCTURED_LOGS=false
# The off-host log platform signs a receipt only after retaining an exact
# canary. Laravel stores public verification keys only; never place the
# provider-side private key in this application environment.
OBSERVABILITY_LOG_RECEIPTS_ENABLED=false
OBSERVABILITY_LOG_RECEIPT_PROVIDER=
OBSERVABILITY_LOG_RECEIPT_ACTIVE_KEY_IDS=
OBSERVABILITY_LOG_RECEIPT_VERIFYING_KEYS={}
OBSERVABILITY_LOG_RECEIPT_MAX_BYTES=32768
OBSERVABILITY_LOG_RECEIPT_MAX_AGE_SECONDS=600
OBSERVABILITY_LOG_RECEIPT_CLOCK_SKEW_SECONDS=120
OBSERVABILITY_LOG_MIN_RETENTION_DAYS=90
OBSERVABILITY_LOG_RECEIPT_WAIT_SECONDS=60
OBSERVABILITY_LOG_RECEIPT_POLL_MS=500
OBSERVABILITY_LOG_RECEIPT_WARNING_SECONDS=90000
OBSERVABILITY_LOG_RECEIPT_OUTAGE_SECONDS=172800
OBSERVABILITY_EXTERNAL_SLI_CONNECTED=false
OBSERVABILITY_SECURITY_EVENTS_CONNECTED=false
OBSERVABILITY_APM_CONNECTED=false

# Database-only disaster recovery. The application records and verifies
# evidence; PITR, encrypted backup, object lock, and isolated restore are
# provider/infrastructure responsibilities. Keep the key ring in a secret
# manager, for example {"v1":"base64:<random-32+-byte-key>"}.
RECOVERY_POINT_OBJECTIVE_SECONDS=300
RECOVERY_TIME_OBJECTIVE_SECONDS=3600
RECOVERY_PROVIDER=
RECOVERY_DATASET_ID=
RECOVERY_PRIMARY_REGION=
RECOVERY_SECONDARY_REGION=
RECOVERY_BACKUP_DESTINATION_ID=
RECOVERY_INDEPENDENT_VERIFIER=
DB_PITR_ENABLED=false
DB_PITR_PROVIDER_MANAGED=false
DB_PITR_CONTINUOUS=false
DB_PITR_RETENTION_DAYS=14
DB_PITR_OBSERVATION_ENABLED=false
DB_PITR_OBSERVATION_WARNING_SECONDS=600
DB_PITR_OBSERVATION_OUTAGE_SECONDS=1200
DB_IMMUTABLE_BACKUP_ENABLED=false
DB_BACKUP_SCOPE=database
DB_BACKUP_ENCRYPTED=false
DB_BACKUP_OFFSITE=false
DB_BACKUP_CROSS_ACCOUNT=false
DB_BACKUP_CROSS_REGION=false
DB_BACKUP_IMMUTABLE=false
DB_BACKUP_OBJECT_LOCK_MODE=
DB_BACKUP_RETENTION_DAYS=35
DB_BACKUP_EXPECTED_INTERVAL_SECONDS=86400
RESTORE_DRILL_ENABLED=false
RESTORE_DRILL_INTERVAL_DAYS=90
RESTORE_DRILL_GRACE_DAYS=14
RESTORE_DRILL_ISOLATED_TARGET_REQUIRED=true
RESTORE_DRILL_PRODUCTION_TARGET_FORBIDDEN=true
RECOVERY_EVIDENCE_ACTIVE_KEY_ID=
RECOVERY_EVIDENCE_SIGNING_KEYS={}
RECOVERY_EVIDENCE_WARNING_SECONDS=7200
RECOVERY_EVIDENCE_OUTAGE_SECONDS=14400
# Only public verifier keys belong here. The external verifier's private key
# must remain outside every application host and repository.
RECOVERY_ATTESTATION_REQUIRED=false
RECOVERY_ATTESTATION_VERIFYING_KEYS={}
RECOVERY_ATTESTATION_ACTIVE_KEY_IDS=
RECOVERY_ATTESTATION_MAX_BYTES=65536
RECOVERY_ATTESTATION_MAX_ENVELOPE_BYTES=98304
RECOVERY_ATTESTATION_CLOCK_SKEW_SECONDS=300
RECOVERY_COMMAND_TIMEOUT_SECONDS=30

# Controlled resilience/game-day evidence. Fault injection is owned by a
# separately credentialed non-production orchestrator; Laravel only verifies
# its public-key signature and maintains a tamper-evident local ledger.
RESILIENCE_DRILLS_ENABLED=false
RESILIENCE_DRILLS_ENFORCE=false
RESILIENCE_TARGET_ENVIRONMENT=staging
RESILIENCE_TARGET_INFRASTRUCTURE_PROFILE=
RESILIENCE_PROVIDER=
RESILIENCE_ORCHESTRATOR=
RESILIENCE_REQUIRED_SCENARIOS=application_node_loss,load_balancer_failover,queue_worker_restart,cache_primary_failover,database_writer_failover
RESILIENCE_CAMPAIGN_INTERVAL_DAYS=90
RESILIENCE_CAMPAIGN_GRACE_DAYS=14
RESILIENCE_MAX_CAMPAIGN_SECONDS=14400
RESILIENCE_PRODUCTION_INJECTION_FORBIDDEN=true
RESILIENCE_EXTERNAL_ORCHESTRATOR_REQUIRED=true
RESILIENCE_MANUAL_APPROVAL_REQUIRED=true
RESILIENCE_CHANGE_REFERENCE_REQUIRED=true
RESILIENCE_SYNTHETIC_TRAFFIC_ONLY=true
RESILIENCE_KILL_SWITCH_REQUIRED=true
RESILIENCE_ONE_FAULT_AT_A_TIME=true
RESILIENCE_MAX_BLAST_RADIUS_PERCENT=50
RESILIENCE_MINIMUM_HEALTHY_INSTANCES=1
RESILIENCE_MAX_SCENARIO_SECONDS=900
RESILIENCE_ABORT_ERROR_RATE_PERCENT=2
RESILIENCE_ABORT_P95_MS=3000
# Map key IDs to base64-encoded PEM public keys. Never place a private key here.
RESILIENCE_EVIDENCE_VERIFYING_KEYS={}
# During rotation, retain old public keys above but list only keys authorized
# to sign newly imported campaigns here (comma-separated).
RESILIENCE_EVIDENCE_ACTIVE_KEY_IDS=
RESILIENCE_EVIDENCE_MAX_BYTES=131072
RESILIENCE_EVIDENCE_MAX_ENVELOPE_BYTES=196608
RESILIENCE_EVIDENCE_CLOCK_SKEW_SECONDS=300
RESILIENCE_LEDGER_ACTIVE_KEY_ID=
RESILIENCE_LEDGER_SIGNING_KEYS={}
RESILIENCE_LEDGER_WARNING_SECONDS=129600
RESILIENCE_LEDGER_OUTAGE_SECONDS=259200
# APP_RELEASE may contain an opaque deployment identifier (for example, a
# short commit SHA). Never place credentials or customer data in this value.
APP_RELEASE=

# Low-cardinality, minute-bucket telemetry: no URL, payload, user, or IP is
