BACKGROUND_WORKERS_MAX_MEDIA_MAINTENANCE=2
BACKGROUND_WORKERS_MIN_MAINTENANCE=1
BACKGROUND_WORKERS_MAX_MAINTENANCE=4
BACKGROUND_WORKERS_MIN_DEFAULT=1
BACKGROUND_WORKERS_MAX_DEFAULT=8

# Vendor-neutral capacity control plane. Keep advisory outside production.
# Each key map is JSON whose values are independent random secrets of at least
# 32 bytes, preferably encoded as base64:<value>. Never reuse APP_KEY or one
# key between CI evidence, platform observations, and application plans.
CAPACITY_PLANNING_ENABLED=true
CAPACITY_PLANNING_ENFORCE=false
CAPACITY_AUTOSCALING_MODE=advisory
CAPACITY_TARGET_ENVIRONMENT=local
CAPACITY_INFRASTRUCTURE_PROFILE=
CAPACITY_DECISION_LOCK_SECONDS=30
CAPACITY_DECISION_LOCK_WAIT_SECONDS=5
CAPACITY_PLATFORM_PROVIDER=
CAPACITY_MANAGED_TARGETS=web,queue:critical,queue:documents,queue:notifications,queue:media_image,queue:media_video,queue:media_maintenance,queue:maintenance,queue:default
CAPACITY_OBSERVATION_MAX_AGE_SECONDS=120
CAPACITY_MINIMUM_LIVE_OBSERVATIONS=2
CAPACITY_MINIMUM_OBSERVATION_SPACING_SECONDS=15
CAPACITY_MAXIMUM_OBSERVATION_SPACING_SECONDS=75
CAPACITY_MAX_CLOCK_SKEW_SECONDS=30
CAPACITY_MAX_PAYLOAD_BYTES=65536
CAPACITY_OBSERVATION_ACTIVE_KEY_ID=
CAPACITY_OBSERVATION_SIGNING_KEYS=
CAPACITY_EVIDENCE_MAX_AGE_DAYS=30
CAPACITY_REQUIRED_EVIDENCE_SCOPES=public_read,booking_checkout,admin,authentication,write
CAPACITY_EVIDENCE_EXPECTED_INSTANCES=2
CAPACITY_EVIDENCE_MIN_HOLD_SECONDS=300
CAPACITY_OPERATIONAL_HEADROOM_PERCENT=25
CAPACITY_EVIDENCE_MAX_ERROR_PERCENT=1
CAPACITY_EVIDENCE_REQUIRE_RELEASE_MATCH=true
CAPACITY_EVIDENCE_ACTIVE_KEY_ID=
CAPACITY_EVIDENCE_SIGNING_KEYS=
CAPACITY_PLAN_TTL_SECONDS=90
CAPACITY_SCALE_UP_COOLDOWN_SECONDS=60
CAPACITY_SCALE_DOWN_COOLDOWN_SECONDS=600
CAPACITY_SCALE_DOWN_STABILIZATION_SECONDS=900
CAPACITY_SCALE_DOWN_REQUIRED_OBSERVATIONS=5
CAPACITY_SCALE_UP_THRESHOLD_PERCENT=65
CAPACITY_SCALE_DOWN_THRESHOLD_PERCENT=35
CAPACITY_MAX_SCALE_UP_STEP=4
CAPACITY_MAX_SCALE_UP_PERCENT=50
CAPACITY_MAX_SCALE_DOWN_STEP=1
CAPACITY_CONVERGENCE_TIMEOUT_SECONDS=300
CAPACITY_PLAN_ACTIVE_KEY_ID=
CAPACITY_PLAN_SIGNING_KEYS=
CAPACITY_WEB_MIN_INSTANCES=2
CAPACITY_WEB_MAX_INSTANCES=20
CAPACITY_CPU_TARGET_PERCENT=65
CAPACITY_MEMORY_TARGET_PERCENT=70
CAPACITY_DB_SCALE_UP_LIMIT_PERCENT=65
CAPACITY_DB_LOCK_WAIT_LIMIT=0
CAPACITY_DB_SLOW_QUERY_LIMIT=1
CAPACITY_QUEUE_ERROR_LIMIT_PERCENT=2
CAPACITY_REQUIRE_DATABASE_TELEMETRY=true
CAPACITY_OBSERVATION_RETENTION_DAYS=31
CAPACITY_EVIDENCE_RETENTION_DAYS=365
CAPACITY_DECISION_RETENTION_DAYS=30
CAPACITY_PRUNE_BATCH_SIZE=1000
CAPACITY_PRUNE_MAX_BATCHES=10

