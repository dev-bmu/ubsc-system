DB_REPLICATION_LAG_WARNING_MS=2000
DB_REPLICATION_LAG_OUTAGE_MS=10000
DB_REPLICATION_OBSERVATION_ENABLED=false
DB_REPLICATION_OBSERVATION_WARNING_SECONDS=120
DB_REPLICATION_OBSERVATION_OUTAGE_SECONDS=300
DB_REPLICATION_ATTESTATION_REQUIRED=false
DB_REPLICATION_ATTESTATION_VERIFYING_KEYS={}
DB_REPLICATION_ATTESTATION_ACTIVE_KEY_IDS=
DB_REPLICATION_ATTESTATION_MAX_BYTES=65536
DB_REPLICATION_ATTESTATION_MAX_ENVELOPE_BYTES=98304
DB_REPLICATION_ATTESTATION_CLOCK_SKEW_SECONDS=120
DB_REPLICATION_ATTESTATION_MAX_AGE_SECONDS=900
DB_REPLICATION_LEDGER_ACTIVE_KEY_ID=
DB_REPLICATION_LEDGER_SIGNING_KEYS={}
DB_REPLICATION_LEDGER_WARNING_SECONDS=7200
DB_REPLICATION_LEDGER_OUTAGE_SECONDS=14400
DB_REPLICATION_EVENT_LIMIT=30
REPLICATION_COMMAND_TIMEOUT_SECONDS=30
REPLICATION_IMPORT_TIMEOUT_SECONDS=30
DB_REPLICATION_BOOTSTRAP_ATTESTATION_FILE=

# Optional eventual reads remain disabled unless a specific read model opts in.
DB_REPLICA_READS_ENABLED=false
DB_REPLICA_CONNECTION=mariadb_replica
DB_REPLICA_FALLBACK_TO_WRITER=true
DB_REPLICA_READ_AFTER_WRITE_SECONDS=30
