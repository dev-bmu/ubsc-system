# PASSKEYS_ALLOWED_ORIGINS=https://example.com
PASSKEYS_TIMEOUT_MS=60000
# During APP_KEY rotation, retain old keys until an explicit audited
# re-encryption process has rewritten every encrypted MFA record.
# APP_PREVIOUS_KEYS=base64:old-key-here
INERTIA_ENCRYPT_HISTORY=true

BROADCAST_CONNECTION=log
