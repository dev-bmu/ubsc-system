APP_NAME="UB Sport Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
GALLERY_CANONICAL_ORIGIN=https://ubsportcenter.co.id
SEO_CANONICAL_ORIGIN=https://ubsportcenter.co.id
SCOUT_DRIVER=null
SCOUT_QUEUE=true
SCOUT_PREFIX=ubsc_
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Payment operational logs contain only sanitized event names, opaque record
# identifiers, and aggregate counters. Add stderr/syslog to this stack when
# the production platform ships logs to durable off-host storage.
PAYMENT_LOG_STACK=payment_daily
PAYMENT_LOG_LEVEL=info
PAYMENT_LOG_DAILY_DAYS=45
PAYMENT_LOG_ARCHIVE_AFTER_DAYS=30
PAYMENT_LOG_RETENTION_DAYS=365
# Keep empty to use storage/app/private/payment-log-archive.
PAYMENT_LOG_ARCHIVE_PATH=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
INERTIA_ENCRYPT_HISTORY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY_MOCK=false
BOOKING_TRANSACTION_FEE=6000
BOOKING_PAYMENT_WINDOW_MINUTES=30
BOOKING_CHECKOUT_MAX_ITEMS=8
BOOKING_MAX_OPEN_HOLDS=2
PAYMENT_CURRENCY=IDR
PAYMENT_TERMS_VERSION=booking-terms-2026-08
MEMBERSHIP_PAYMENT_WINDOW_HOURS=24
PAYMENT_RECOVERY_STALE_SECONDS=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
