MONITORING_SCHEDULER_OUTAGE_SECONDS=300
MONITORING_QUEUE_CONNECTION=database
MONITORING_QUEUE_NAME=default
MONITORING_QUEUE_WARNING_SECONDS=180
MONITORING_QUEUE_OUTAGE_SECONDS=600
MONITORING_QUEUE_WARNING_DEPTH=100
MONITORING_QUEUE_OUTAGE_DEPTH=500
MONITORING_USAGE_WINDOW_MINUTES=1440
