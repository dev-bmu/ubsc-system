DB_REPLICA_PORT=3306
DB_REPLICA_DATABASE=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_REPLICA_SOCKET=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Production HTTPS deployments should explicitly set this to true. When it
# is omitted, config/session.php enables it automatically in production.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_MINUTES=480
ADMIN_SESSION_ROTATE_MINUTES=15
ADMIN_SESSION_BIND_USER_AGENT=true
ADMIN_SESSION_LOCK_SECONDS=60
